# ====================================================================
# Environment Variables Configuration
# Copy this file to .env and replace the placeholders with real keys.
# ====================================================================

# News API Configuration (https://newsapi.org/)
# Leave blank to automatically use RSS feeds fallback
NEWS_API_KEY=

# Google Gemini API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY=
# Optional: customize Gemini model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
APP_ENV=development
DATABASE_PATH=data/news_database.db

